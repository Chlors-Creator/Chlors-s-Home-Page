---
const path = Astro.url.pathname;
const isActive = (prefix: string) => path === prefix || path.startsWith(`${prefix}/`);
---
<aside class="sidebar">
  <div class="identity">
    <div class="avatar">
      <img src="/avatar.jpg" alt="乃春_Chlors" transition:persist="sidebar-avatar" />
    </div>
    <h2>乃春_Chlors</h2>
    <p class="presence" aria-live="polite" transition:persist="presence-status">
      <span class="presence-line is-offline" data-presence="steam">Steam：离线</span>
      <span class="presence-line is-offline" data-presence="netease">网易云：离线</span>
    </p>
    <p>来如春梦几多时，去似朝云无觅处</p>
  </div>

  <nav class="side-links" aria-label="主导航">
    <a href="/" data-astro-prefetch="viewport">
      01 主页
      <span class={path === '/' ? 'is-active' : ''}>● {path === '/' ? 'Active' : 'Idle'}</span>
    </a>
    <a href="/archive/" data-astro-prefetch="viewport">
      02 归档
      <span class={isActive('/archive') ? 'is-active' : ''}>● {isActive('/archive') ? 'Active' : 'Idle'}</span>
    </a>
    <a href="/topics/" data-astro-prefetch="viewport">
      03 专题
      <span class={isActive('/topics') ? 'is-active' : ''}>● {isActive('/topics') ? 'Active' : 'Idle'}</span>
    </a>
    <a href="/playlists/" data-astro-prefetch="viewport">
      04 歌单
      <span class={isActive('/playlists') ? 'is-active' : ''}>● {isActive('/playlists') ? 'Active' : 'Idle'}</span>
    </a>
    <a href="/journal/" data-astro-prefetch="viewport">
      05 日志
      <span class={isActive('/journal') ? 'is-active' : ''}>● {isActive('/journal') ? 'Active' : 'Idle'}</span>
    </a>
    <a href="/links/" data-astro-prefetch="viewport">
      06 友链
      <span class={isActive('/links') ? 'is-active' : ''}>● {isActive('/links') ? 'Active' : 'Idle'}</span>
    </a>
    <a href="/about/" data-astro-prefetch="viewport">
      07 关于
      <span class={isActive('/about') ? 'is-active' : ''}>● {isActive('/about') ? 'Active' : 'Idle'}</span>
    </a>
    <a href="/console/" data-astro-prefetch="viewport">
      08 控制台
      <span class={isActive('/console') ? 'is-active' : ''}>● {isActive('/console') ? 'Active' : 'Idle'}</span>
    </a>
  </nav>

  <button class="theme-toggle" type="button">◐ <span>切换主题</span></button>

  <div class="site-credit">
    <p>© 2026 Chlors. All Rights Reserved.</p>
    <nav class="site-credit__links" aria-label="站点链接">
      <a href="/rss.xml">RSS</a>
      <span>/</span>
      <a href="/sitemap-index.xml">Sitemap</a>
    </nav>
    <p>
      Built with
      <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">
        <img
          width="12"
          height="12"
          loading="lazy"
          src="https://cdn.simpleicons.org/astro"
          alt="Astro logo"
          transition:persist="credit-astro"
        />
        Astro
      </a>
      and
      <a href="https://www.typescriptlang.org/" target="_blank" rel="noopener noreferrer">
        <img
          width="12"
          height="12"
          loading="lazy"
          src="https://cdn.simpleicons.org/typescript"
          alt="TypeScript logo"
          transition:persist="credit-typescript"
        />
        TypeScript
      </a>.
    </p>
    <p>
      Music powered by
      <a href="https://521dimensions.com/open-source/amplitudejs/" target="_blank" rel="noopener noreferrer">
        <img
          width="12"
          height="12"
          loading="lazy"
          src="https://serversideup.net/open-source/amplitudejs/favicon.svg"
          alt="AmplitudeJS logo"
          transition:persist="credit-amplitudejs"
        />
        AmplitudeJS
      </a>.
    </p>
    <p>
      Deployed on
      <a href="https://workers.cloudflare.com/" target="_blank" rel="noopener noreferrer">
        <img
          width="12"
          height="12"
          loading="lazy"
          src="https://cdn.simpleicons.org/cloudflare"
          alt="Cloudflare logo"
          transition:persist="credit-cloudflare"
        />
        Cloudflare Workers
      </a>.
    </p>
  </div>
</aside>
