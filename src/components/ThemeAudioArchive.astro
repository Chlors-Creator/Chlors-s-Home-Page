---
import MusicPlayer from './MusicPlayer.astro';
import AudioArchiveLayout from '../layouts/AudioArchiveLayout.astro';
import definitions from '../data/playlists.json';
import library from '../generated/music-library.json';

interface PlaylistDefinition { title: string; directory: string; children?: PlaylistDefinition[] }
interface MusicTrack { title: string; artist: string; src: string; cover: string; duration: number; durationLabel: string; lyricsSrc: string | null }
interface ArchiveFolder { path: string; title: string; tracks: MusicTrack[] }
interface ArchiveTrack extends MusicTrack { globalIndex: number; folderIndex: number; folderPath: string; folderTitle: string; trackIndex: number; folderTrackCount: number }

const SHELF_SLOTS = 20;
const playlists = library.playlists as Record<string, MusicTrack[]>;
const definitionsByPath = new Map<string, PlaylistDefinition>();
for (const definition of definitions as PlaylistDefinition[]) {
  definitionsByPath.set(definition.directory, definition);
  for (const child of definition.children ?? []) definitionsByPath.set(`${definition.directory}/${child.directory}`, child);
}

const folders: ArchiveFolder[] = Object.entries(playlists)
  .filter(([, tracks]) => tracks.length > 0)
  .sort(([left], [right]) => left.localeCompare(right, 'zh-CN', { numeric: true }))
  .map(([path, tracks]) => {
    const definition = definitionsByPath.get(path);
    if (!definition) throw new Error(`Missing playlist definition for public/music/${path}`);
    const orderedTracks = [...tracks].sort((left, right) => left.artist.localeCompare(right.artist, 'zh-CN') || left.title.localeCompare(right.title, 'zh-CN'));
    return { path, title: definition.title, tracks: orderedTracks };
  });

const archiveTracks: ArchiveTrack[] = folders.flatMap((folder, folderIndex) =>
  folder.tracks.map((track, trackIndex) => ({ ...track, globalIndex: 0, folderIndex, folderPath: folder.path, folderTitle: folder.title, trackIndex, folderTrackCount: folder.tracks.length })),
).map((track, index) => ({ ...track, globalIndex: index }));
const folderRecords = folders.map((folder, folderIndex) => {
  const firstTrack = archiveTracks.find((track) => track.folderIndex === folderIndex);
  if (!firstTrack) throw new Error(`Music folder ${folder.path} has no playable tracks.`);
  return { folder, folderIndex, firstTrack };
});

const trackCount = archiveTracks.length;
const initialFolder = folders.reduce((largest, folder) => folder.tracks.length > largest.tracks.length ? folder : largest);
const initialTrackIndex = Math.min(7, initialFolder.tracks.length - 1);
const firstTrack = archiveTracks.find((track) => track.folderPath === initialFolder.path && track.trackIndex === initialTrackIndex);
if (!firstTrack) throw new Error('Music archive has no playable tracks.');
const shelfCount = folders.reduce((count, folder) => count + Math.ceil(folder.tracks.length / SHELF_SLOTS), 0);
const initialShelfIndex = folders.slice(0, firstTrack.folderIndex).reduce((count, folder) => count + Math.ceil(folder.tracks.length / SHELF_SLOTS), 0)
  + Math.floor(firstTrack.trackIndex / SHELF_SLOTS);
const manifest = JSON.stringify(archiveTracks).replace(/</g, '\\u003c');
const indexLabel = (index: number, width = 2) => String(index + 1).padStart(width, '0');
---

<AudioArchiveLayout title="音乐档案">
  <main id="audio-archive-page">
    <header class="archive-topbar">
      <a class="archive-brand" href="#archive" aria-label="音乐档案首页">
        <span class="archive-emblem" aria-hidden="true"><canvas id="archive-emblem" width="184" height="88"></canvas></span>
        <span class="archive-brand-copy"><strong>AUDIO ARCHIVE</strong><small>信号　·　曲库　·　播放</small><b>聆听终端</b></span>
      </a>
      <nav class="archive-nav" aria-label="档案导航">
        <a class="active" href="#archive"><small>01</small> 档案</a>
        <a href="#archive-playlists"><small>02</small> 歌单</a>
        <a href="#archive-player"><small>03</small> 歌词</a>
        <a href="#archive-player"><small>04</small> 信号</a>
        <a href="#archive-player"><small>05</small> 风格</a>
      </nav>
      <label class="archive-search"><span>搜索曲库</span><input id="archive-search" type="search" aria-label="搜索音乐档案" /><b aria-hidden="true">⌕</b></label>
      <time class="archive-clock"><strong id="archive-clock">00:00:00</strong><small id="archive-date">--</small></time>
      <button class="archive-menu" type="button" aria-label="切换明暗主题" data-theme-toggle><span aria-hidden="true">☰</span> 菜单</button>
    </header>

    <div class="archive-workspace" id="archive">
      <section class="archive-stage" aria-label="音乐档案唱片阵列">
        <output class="archive-render-error" id="archive-render-error" hidden></output>
        <div class="archive-toolbar" aria-label="档案显示选项">
          <div class="toolbar-row">
            <div class="toolbar-set"><span>显示</span><button type="button" disabled>专辑</button><button class="selected" type="button" aria-pressed="true">曲目</button></div>
            <div class="toolbar-set"><span>布局</span><button class="selected" type="button" aria-pressed="true" data-layout="array">▰ 阵列</button><button type="button" data-layout="grid">□ 网格</button></div>
          </div>
          <div class="toolbar-row">
            <div class="toolbar-set"><span>分组</span><button class="selected" type="button" aria-pressed="true" data-group="genre">流派</button><button type="button" data-group="decade" disabled>年代</button><button type="button" data-group="artist">艺人</button><button type="button" data-group="none">无</button></div>
            <div class="toolbar-set"><span>排序</span><button class="selected" type="button" aria-pressed="true" data-sort="artist">艺人</button><button type="button" data-sort="title">标题</button><button type="button" data-sort="year" disabled>年份</button><button type="button" data-sort="added" disabled>收录时间</button></div>
          </div>
        </div>

        <div class="archive-gallery" id="archive-gallery" data-layout="array" data-archive-manifest={manifest} data-shelf-count={shelfCount} data-initial-selection={firstTrack.globalIndex}>
          <canvas id="archive-canvas" tabindex="0" role="img" aria-label="音乐档案唱片阵列。使用方向键选择唱片，回车检查，空格播放。"></canvas>
          <div class="archive-grid" id="archive-grid" hidden>
            {folders.map((folder, folderIndex) => (
              <section class="grid-folder" data-grid-folder={folderIndex}>
                <header><span>歌单 / {indexLabel(folderIndex)}</span><strong>{folder.title.toUpperCase()}</strong><small>{folder.tracks.length} 首曲目</small></header>
                <div class="grid-folder-tracks">
                  {archiveTracks.filter((track) => track.folderIndex === folderIndex).map((track) => (
                    <button class="grid-track" type="button" data-grid-track data-global-index={track.globalIndex}>
                      <img src={track.cover} alt="" loading="lazy" /><span><small>{track.artist}</small><strong>{track.title}</strong></span><time>{track.durationLabel}</time>
                    </button>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>

        <div class="archive-counter"><small>曲目 / 选择</small><div><strong data-selected-number aria-label={String(firstTrack.trackIndex % SHELF_SLOTS + 1).padStart(2, '0')}>{String(firstTrack.trackIndex % SHELF_SLOTS + 1).padStart(2, '0')}</strong><span>/ <b data-shelf-track-count>{String(SHELF_SLOTS).padStart(2, '0')}</b></span></div></div>
        <div class="archive-ruler" aria-label="唱片索引"><button type="button" data-track-step="-1" aria-label="上一首">↑</button><span data-ruler></span><button type="button" data-track-step="1" aria-label="下一首">↓</button></div>
        <div class="archive-shelf-switch"><button type="button" data-shelf-step="1" aria-label="下一层唱片架">←</button><div><small>唱片架 <span data-shelf-number>{String(initialShelfIndex + 1).padStart(2, '0')}</span> / {String(shelfCount).padStart(2, '0')}</small><strong data-folder-name>{initialFolder.title}</strong></div><button type="button" data-shelf-step="-1" aria-label="上一层唱片架">→</button></div>
        <button class="inspection-return" id="inspection-return" type="button" hidden>← &nbsp; 返回档案</button>
      </section>

      <aside class="archive-file-panel" id="archive-playlists" data-folder-watermark={initialFolder.title.toUpperCase()} aria-label="选中音乐详情">
        {folderRecords.map(({ folder, folderIndex, firstTrack: folderFirstTrack }) => (
          <article class="archive-detail" data-detail-folder={folderIndex} hidden={folderIndex !== firstTrack.folderIndex}>
            <div class="detail-breadcrumb">音乐档案 <span>/</span> <b>{folder.title}</b></div>
            <div class="detail-number"><span>曲目编号 <strong data-track-number>{indexLabel(folderFirstTrack.globalIndex, 4)}</strong></span><span class="format-chip">■ MP3</span></div>
            <h1 data-current-title>{folderFirstTrack.title}</h1>
            <p class="detail-artist" data-current-artist>{folderFirstTrack.artist}</p>
            <p class="detail-meta" data-current-meta>{folder.title.toUpperCase()} / {folderFirstTrack.durationLabel}</p>
            <section class="detail-profile" aria-label="音乐信息">
              <header><strong>信息</strong><span data-profile-code>ARC-{indexLabel(folderFirstTrack.globalIndex, 4)}</span></header>
              <dl><dt>格式</dt><dd>音频</dd><dt>规格</dt><dd>—</dd><dt>流派</dt><dd>{folder.title.toUpperCase()}</dd><dt>曲目</dt><dd>01</dd><dt>收录</dt><dd>—</dd><dt>来源</dt><dd>公开曲库</dd></dl>
            </section>
            <ol class="archive-track-list">
              <li data-detail-track data-global-index={folderFirstTrack.globalIndex}><button type="button" aria-pressed={folderFirstTrack.globalIndex === firstTrack.globalIndex ? 'true' : 'false'}><span>01</span><strong data-detail-title>{folderFirstTrack.title}</strong><time data-detail-duration>{folderFirstTrack.durationLabel}</time></button></li>
            </ol>
            <div class="archive-actions"><button class="action-primary" type="button" data-play-track>▶ 播放曲目</button><button class="action-secondary" type="button" data-open-folder>打开歌单 <span>↗</span></button></div>
            <small class="detail-source">来源 · public/music/{folder.path}</small>
          </article>
        ))}
      </aside>
    </div>

    <footer class="archive-footer" id="archive-player">
      <div class="transport-row">
        <div class="transport-cover"><img id="transport-cover" alt="" hidden /><span></span></div>
        <div id="music-player-slot" aria-label="音乐播放控制">
          {folders.map((folder) => (
            <div data-music-category={folder.path} hidden>
              <MusicPlayer playlist={{ slug: folder.path, title: folder.title }} tracks={folder.tracks} showTrackList={false} defaultVolume={1} />
            </div>
          ))}
        </div>
        <div class="transport-options"><button type="button" data-shuffle-all>▧ 全部随机</button><span>模式</span><button type="button" data-order-button>列表循环</button><button type="button" data-theme-shortcut data-theme-value="light">□ 浅色</button><button type="button" class="selected" data-theme-shortcut data-theme-value="dark">■ 深色</button></div>
      </div>
      <div class="status-row"><div><span class="status-mark"></span><strong>档案区 · 浏览</strong></div><div><span>{trackCount.toLocaleString('zh-CN')} 首曲目</span><span>·</span><span>{shelfCount} 层唱片架</span><strong>AUDIO ARCHIVE</strong></div></div>
    </footer>
  </main>
</AudioArchiveLayout>

<script>
  import '../scripts/music/index.ts';
  import '../rhine-music-ui/archive-emblem';
  import '../rhine-music-ui/music-archive.ts';
</script>
