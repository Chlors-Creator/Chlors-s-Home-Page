---
const destination = '/music/gate/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={destination} />
    <title>音乐播放器已迁移</title>
  </head>
  <body>
    <p>音乐播放器已迁移至 <a href={destination}>/music/gate</a>。</p>
  </body>
</html>
