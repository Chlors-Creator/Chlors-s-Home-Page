---
import Sidebar from '../components/Sidebar.astro';
import ThemeModal from '../components/ThemeModal.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/page-transitions.css';
import '../styles/content.css';
import '../styles/links.css';
import '../styles/console-cards.css';
import '../styles/playlist-covers.css';
import '../styles/music-player.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <title>{title} // 乃春_Chlors</title>
    <link rel="stylesheet" href="/theme-modal.css?v=20260905-2" />
    <script is:inline>
      document.documentElement.dataset.themeChoice = localStorage.getItem('site-theme-choice') || 'paper';
    </script>
    <ClientRouter />
  </head>
  <body>
    <Sidebar />
    <main>
      <div class="page-content">
        <slot />
      </div>
    </main>
    <ThemeModal />
    <script is:inline src="/presence.js?v=20260921-1"></script>
  </body>
</html>
